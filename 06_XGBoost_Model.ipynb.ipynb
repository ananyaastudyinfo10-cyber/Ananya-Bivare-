    "# =====================================================\n",
    "# Load Dataset\n",
    "# =====================================================\n",
    "\n",
    "silver = pd.read_csv(\"../outputs/feature_engineered_silver.csv\")\n",
    "\n",
    "silver.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "07bda72f-c3ee-409c-a1a6-7e8c97fc6596",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Feature Matrix Shape: (6753, 19)\n",
      "Target Shape: (6753,)\n"
     ]
    }
   ],
   "source": [
    "# =====================================================\n",
    "# Feature Selection\n",
    "# =====================================================\n",
    "\n",
    "features = [\n",
    "    \"Open\",\n",
    "    \"High\",\n",
    "    \"Low\",\n",
    "    \"Volume\",\n",
    "    \"Lag_1\",\n",
    "    \"Lag_3\",\n",
    "    \"Lag_7\",\n",
    "    \"Lag_14\",\n",
    "    \"Lag_30\",\n",
    "    \"MA_7\",\n",
    "    \"MA_14\",\n",
    "    \"MA_30\",\n",
    "    \"EMA_7\",\n",
    "    \"EMA_14\",\n",
    "    \"EMA_30\",\n",
    "    \"Volatility_7\",\n",
    "    \"Volatility_14\",\n",
    "    \"RSI_14\",\n",
    "    \"MACD\"\n",
    "]\n",
    "\n",
    "X = silver[features]\n",
    "\n",
    "y = silver[\"Close\"]\n",
    "\n",
    "print(\"Feature Matrix Shape:\", X.shape)\n",
    "print(\"Target Shape:\", y.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "cbdacf79-e8ce-47b6-948e-4dbb5b5c1c3e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training: (5402, 19)\n",
      "Testing : (1351, 19)\n"
     ]
    }
   ],
   "source": [
    "# =====================================================\n",
    "# Train-Test Split\n",
    "# =====================================================\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X,\n",
    "    y,\n",
    "    test_size=0.20,\n",
    "    shuffle=False\n",
    ")\n",
    "\n",
    "print(\"Training:\", X_train.shape)\n",
    "print(\"Testing :\", X_test.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "95679e3e-a12d-4b7a-8727-5bac4f891b31",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "XGBoost model trained successfully.\n"
     ]
    }
   ],
   "source": [
    "# =====================================================\n",
    "# XGBoost Model\n",
    "# =====================================================\n",
    "\n",
    "model = XGBRegressor(\n",
    "    n_estimators=200,\n",
    "    learning_rate=0.05,\n",
    "    max_depth=6,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "print(\"XGBoost model trained successfully.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "074e9491-0c8e-4ed6-bdb4-0d36d639cdd3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================\n",
    "# Prediction\n",
    "# =====================================================\n",
    "\n",
    "predictions = model.predict(X_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "822b3ef9-42d5-4714-ba0a-f5aab34d8c52",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "MAE  : 0.1051\n",
      "RMSE : 0.1552\n",
      "R²   : 0.9987\n"
     ]
    }
   ],
   "source": [
    "# =====================================================\n",
    "# Evaluation\n",
    "# =====================================================\n",
    "\n",
    "mae = mean_absolute_error(y_test, predictions)\n",
    "\n",
    "rmse = np.sqrt(mean_squared_error(y_test, predictions))\n",
    "\n",
    "r2 = r2_score(y_test, predictions)\n",
    "\n",
    "print(f\"MAE  : {mae:.4f}\")\n",
    "print(f\"RMSE : {rmse:.4f}\")\n",
    "print(f\"R²   : {r2:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "99f8370f-7654-43b0-910e-773aaefcff2d",
   "metadata": {},
