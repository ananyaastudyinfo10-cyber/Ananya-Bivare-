    "# =====================================================\n",
    "# Rolling Volatility\n",
    "# =====================================================\n",
    "\n",
    "silver[\"Rolling_Volatility\"] = (\n",
    "\n",
    "silver[\"Daily_Return\"]\n",
    "\n",
    ".rolling(30)\n",
    "\n",
    ".std()\n",
    "\n",
    ")\n",
    "\n",
    "silver.head()"
   ]
  },
