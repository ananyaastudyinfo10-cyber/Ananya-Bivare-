      "-0.7572851939147217\n"
     ]
    }
   ],
   "source": [
    "# =====================================================\n",
    "# Maximum Drawdown\n",
    "# =====================================================\n",
    "\n",
    "silver[\"Cumulative_Return\"] = (\n",
    "\n",
    "1 + silver[\"Daily_Return\"]\n",
    "\n",
    ").cumprod()\n",
    "\n",
    "silver[\"Running_Max\"] = (\n",
    "\n",
    "silver[\"Cumulative_Return\"]\n",
    "\n",
    ").cummax()\n",
    "\n",
    "silver[\"Drawdown\"] = (\n",
    "\n",
    "silver[\"Cumulative_Return\"]\n",
    "\n",
    "-\n",
    "\n",
    "silver[\"Running_Max\"]\n",
    "\n",
    ") / silver[\"Running_Max\"]\n",
    "\n",
    "print(\"Maximum Drawdown\")\n",
    "\n",
    "print(silver[\"Drawdown\"].min())"
   ]
  },
